# Copy this file to .env.local and fill in real values (gitignored)

EXPO_PUBLIC_BASE_URL=https://api.talex.pro.vn/

# Web OAuth Client ID from Google Cloud Console (type: Web application).
# This is NOT the Android client ID — it's used as `webClientId` so
# GoogleSignin issues an idToken the backend can verify (aud = this client id).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
